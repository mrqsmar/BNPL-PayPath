# Database
DATABASE_URL="postgresql://user:password@localhost:5432/paypath?schema=public"

# Session
SESSION_SECRET="change-me-to-a-random-secret"

# Admin credentials
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-to-a-strong-password"

# Server
PORT=3001

# Client (Vite dev server)
VITE_API_URL="http://localhost:3001"

# App base URL (used in payment links sent to customers)
APP_BASE_URL="http://localhost:5173"

# SendGrid (email)
SENDGRID_API_KEY="SG.your-api-key"
SENDGRID_FROM_EMAIL="payments@yourdomain.com"

# Twilio (SMS)
TWILIO_ACCOUNT_SID="your-account-sid"
TWILIO_AUTH_TOKEN="your-auth-token"
TWILIO_FROM_NUMBER="+15551234567"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe publishable key (exposed to client via Vite)
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."
